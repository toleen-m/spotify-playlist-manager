<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.PlaylistController"
      stylesheets="@style.css"
      spacing="10">

    <Label fx:id="nomPlaylist" text="Playlist"/>

    <Label fx:id="labelDureeTotale" text="Durée totale : 0 s"/>

    <TableView fx:id="tablePlaylist">
        <columns>
            <TableColumn fx:id="colTitre" text="Titre"/>
            <TableColumn fx:id="colArtiste" text="Artiste"/>
            <TableColumn fx:id="colDuree" text="Durée"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button text="Retirer" onAction="#retirerChanson"/>
        <Button text="Monter" onAction="#monterChanson"/>
        <Button text="Descendre" onAction="#descendreChanson"/>
        <Button text="Vider" onAction="#viderPlaylist"/>
    </HBox>

</VBox>