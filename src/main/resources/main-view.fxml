<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.MainController"
            stylesheets="@style.css">

    <top>
        <VBox spacing="12" styleClass="top-section">
            <Label text="Spotify Playlist Manager" styleClass="main-title"/>
            <HBox spacing="15" alignment="BOTTOM_LEFT" styleClass="search-section">

                <VBox spacing="5">
                    <Label text="Recherche"/>
                    <TextField fx:id="champRecherche"
                               promptText="Rechercher..."
                               prefWidth="230"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Rechercher par"/>
                    <ComboBox fx:id="comboRecherche"
                              promptText="Rechercher par"
                              prefWidth="150"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Genre"/>
                    <ComboBox fx:id="comboGenre"
                              promptText="Genre"
                              prefWidth="140"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Tri"/>
                    <ComboBox fx:id="comboTri"
                              promptText="Trier"
                              prefWidth="140"/>
                </VBox>
            </HBox>
            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="filter-section">

                <VBox spacing="3">
                    <Label text="Durée max"/>
                    <Slider fx:id="sliderDuree"
                            min="0"
                            max="400"
                            value="400"
                            prefWidth="180"/>
                </VBox>
                <VBox spacing="3">
                    <Label text="Écoutes min"/>
                    <Slider fx:id="sliderEcoutes"
                            min="0"
                            max="500000"
                            value="0"
                            prefWidth="180"/>
                </VBox>
                <HBox spacing="12" alignment="BOTTOM_LEFT">
                    <Button text="Lancer tri"
                            onAction="#lancerTri"/>
                    <Button text="Benchmark"
                            onAction="#afficherBenchmark"/>
                </HBox>
                <Label fx:id="labelGagnant" text=""/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox>

            <TableView fx:id="tableChansons">
                <columns>
                    <TableColumn fx:id="colTitre" text="Titre"/>
                    <TableColumn fx:id="colArtiste" text="Artiste"/>
                    <TableColumn fx:id="colAlbum" text="Album"/>
                    <TableColumn fx:id="colAnnee" text="Année"/>
                    <TableColumn fx:id="colGenre" text="Genre"/>
                    <TableColumn fx:id="colDuree" text="Durée"/>
                    <TableColumn fx:id="colEcoutes" text="Écoutes"/>
                </columns>
            </TableView>

            <HBox spacing="8" alignment="CENTER" styleClass="pagination">
                <Button text="←" onAction="#pagePrecedente"/>
                <Label fx:id="labelPage" text="Page 1"/>
                <Button text="→" onAction="#pageSuivante"/>
            </HBox>

        </VBox>
    </center>


    <right>
        <VBox spacing="10" styleClass="playlist-section">
            <Button text="Bibliothèque" onAction="#afficherBibliotheque"/>
            <Label text="Playlists" styleClass="playlist-title"/>
            <ListView fx:id="listePlaylists"/>
            <Button text="Créer playlist" onAction="#creerPlaylist"/>
            <Button text="Ajouter chanson" onAction="#ajouterPlaylist"/>
            <Button text="Supprimer playlist" onAction="#supprimerPlaylist"/>
        </VBox>
    </right>


    <bottom>
        <VBox spacing="10" styleClass="bottom-section">
            <Label fx:id="chansonActuelle" text="Aucune chanson"/>
            <ProgressBar fx:id="progressionChanson"
                         progress="0"
                         prefWidth="300"/>
            <Label fx:id="ecoutesChanson" text="Écoutes : 0"/>

            <HBox spacing="12">
                <Button text="Previous" onAction="#precedent"/>
                <Button text="Play" onAction="#play"/>
                <Button text="Pause" onAction="#pause"/>
                <Button text="Next" onAction="#suivant"/>
                <Button text="Shuffle" onAction="#shuffle"/>
            </HBox>
            <HBox spacing="12">
                <Button text="Ajouter" onAction="#ajouterChanson"/>
                <Button text="Modifier" onAction="#modifierChanson"/>
                <Button text="Supprimer" onAction="#supprimerChanson"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>